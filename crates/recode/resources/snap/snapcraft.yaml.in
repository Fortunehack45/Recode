name: recode
title: Recode
base: core24
version: "$RELEASE_VERSION"
summary: The editor for what's next
description: |
  Recode is a modern open-source code editor, built from the ground up in Rust with
  a GPU-accelerated renderer. We help you build software faster than ever before.
grade: stable
confinement: classic
compression: lzo
website: https://github.com/Fortunehack45/Recode
source-code: https://github.com/Fortunehack45/Recode
issues: https://github.com/Fortunehack45/Recode/issues
contact: https://github.com/Fortunehack45/Recode/issues

parts:
  recode:
    plugin: dump
    source: "https://github.com/Fortunehack45/Recode/releases/download/v$RELEASE_VERSION/recode-linux-x86_64.tar.gz"

    organize:
      # These renames seem to not be necessary, but it's tidier.
      bin: usr/bin
      libexec: usr/libexec

    stage-packages:
      - libasound2t64
      # snapcraft has a lint that this is unused, but without it Recode exits with
      # "Missing Vulkan entry points: LibraryLoadFailure" in wgpu.
      - libvulkan1
      # snapcraft has a lint that this is unused, but without it Recode exits with
      # "NoWaylandLib" when run with Wayland.
      - libwayland-client0
      - libxcb1
      - libxkbcommon-x11-0
      - libxkbcommon0

    build-attributes:
      - enable-patchelf

    prime:
      # Omit unneeded files from the tarball
      - -lib
      - -licenses.md
      - -share

      # Omit unneeded files from stage-packages
      - -etc
      - -usr/share/doc
      - -usr/share/lintian
      - -usr/share/man

apps:
  recode:
    command: usr/bin/recode
    common-id: dev.recode.Recode
    environment:
      RECODE_BUNDLE_TYPE: snap
