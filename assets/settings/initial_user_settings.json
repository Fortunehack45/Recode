// Recode settings
//
// For information on how to configure Recode, see the Recode
// documentation: https://github.com/Fortunehack45/Recode#readme
//
// To see all of Recode's default settings without changing your
// custom settings, run `open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  // Model Context Protocol (MCP) servers for 3D game engines, cloud backends, and AI media
  "context_servers": {
    "unreal-engine": {
      "command": "npx",
      "args": ["-y", "unreal-engine-mcp"]
    },
    "blender": {
      "command": "npx",
      "args": ["-y", "blender-mcp"]
    },
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server"]
    },
    "vercel": {
      "command": "npx",
      "args": ["-y", "@vercel/mcp-server"]
    },
    "higgsfield": {
      "command": "npx",
      "args": ["-y", "@higgsfield/mcp-server"]
    }
  }
}
