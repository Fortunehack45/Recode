[Desktop Entry]
Name=Recode
Comment=Recode AI Code Editor
GenericName=Recode
Exec=/usr/share/recode/bin/recode %F
Icon=code
Type=Application
StartupNotify=true
Categories=Utility;TextEditor;Development;IDE;
MimeType=text/plain;inode/directory;application/x-code-workspace;
Actions=new-empty-window;
Keywords=Development;IDE;Recode;AI;

[Desktop Action new-empty-window]
Name=New Empty Window
Exec=/usr/share/recode/bin/recode --new-window %F
Icon=code
