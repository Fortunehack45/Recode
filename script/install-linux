#!/usr/bin/env bash

set -euxo pipefail

if [[ $# -gt 0 ]]; then
  echo "
  Usage: ${0##*/}
  Builds and installs recode onto your system into ~/.local, making it available as ~/.local/bin/recode.

  Before running this you should ensure you have all the build dependencies installed with `./script/linux`.
  "
  exit 1
fi
export RECODE_CHANNEL=$(<crates/recode/RELEASE_CHANNEL)
export RECODE_UPDATE_EXPLANATION="You need to fetch and rebuild recode in $(pwd)"
script/bundle-linux

arch="$(uname -m)"
commit=$(git rev-parse HEAD | cut -c 1-7)
archive="recode-linux-${arch}.tar.gz"
export RECODE_BUNDLE_PATH="${CARGO_TARGET_DIR:-target}/release/${archive}"
script/install.sh
